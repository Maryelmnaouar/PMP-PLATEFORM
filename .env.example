# Copier en .env (jamais envoyé sur GitHub) ou définir dans Render → Environment
SECRET_KEY=une-longue-chaine-aleatoire
DATA_DIR=./data                  # dossier de la base SQLite et des photos (Render : /var/data)
ADMIN_USERNAME=admin             # compte administrateur créé au premier démarrage
ADMIN_PASSWORD=                  # vide = mot de passe provisoire affiché dans les logs
ADMIN_NAME=Administrateur
SESSION_COOKIE_SECURE=0          # 1 en production (HTTPS)
SEED_BASE_DATA=1                 # 1 = créer l'usine Cobomi, la ligne et les 26 équipements ; 0 = base vide
